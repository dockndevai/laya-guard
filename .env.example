# --- Endpoint ----------------------------------------------------------------
# The guard is a local decision service. Keep it on loopback.
LAYA_GUARD_HOST=127.0.0.1
LAYA_GUARD_PORT=8799
# Allow a non-loopback bind (DANGEROUS: anything that reaches it influences allow/block decisions).
LAYA_GUARD_ALLOW_REMOTE=false

# --- Policy ------------------------------------------------------------------
# Path to a JSON org-policy file (see policy.example.json). Omit to use built-in defaults.
LAYA_GUARD_POLICY=
# Risk level at/above which the decision becomes "confirm" / "block".
#   (thresholds live in the policy file: confirm_threshold / block_threshold)

# --- Model -------------------------------------------------------------------
# Checkpoint: auto (Router picks) | english | multilingual | typed-decisions.
LAYA_GUARD_MODEL=auto
LAYA_GUARD_DEVICE=auto
# Allow the one-time laya checkpoint download. Off by default (offline). Pre-fetch once, then run offline.
LAYA_GUARD_ALLOW_DOWNLOAD=false

# --- Safety knobs ------------------------------------------------------------
# Below this calibrated confidence, an "allow" is escalated to "confirm" (fail-closed).
LAYA_GUARD_MIN_CONFIDENCE=0.55
# When the model can't run and no pattern matches: true = confirm (fail closed), false = allow.
LAYA_GUARD_FAIL_CLOSED=true
# Max characters of a command/context considered.
LAYA_GUARD_MAX_INPUT_CHARS=8000
# Emit a JSON audit line per decision to stderr.
LAYA_GUARD_AUDIT_LOG=true
